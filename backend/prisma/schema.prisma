model SessionReservation {
 id Int @id @default(autoincrement())
 entitlementId Int
 entitlement SessionEntitlement @relation(fields:[entitlementId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 appointmentId Int @unique
 appointment Appointment @relation(fields:[appointmentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 status String @default("ACTIVE") @db.VarChar(20)
 createdAt DateTime @default(now())
