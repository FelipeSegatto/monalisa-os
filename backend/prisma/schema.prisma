 @@index([offerId,startsOn])
}
model CommercialOfferItem {
 id Int @id @default(autoincrement())
 versionId Int
 version CommercialOfferVersion @relation(fields:[versionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 variationId Int?
 variation ProcedureVariation? @relation(fields:[variationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 procedureName String @db.VarChar(150)
 variationName String? @db.VarChar(140)
 sessions Int
 referenceUnitPrice Decimal @db.Decimal(12,2)
}
model SaleOfferPurchase {
 id Int @id @default(autoincrement())
 saleId Int
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 versionId Int
 version CommercialOfferVersion @relation(fields:[versionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 offerName String @db.VarChar(150)
 quantity Int
 items SaleItem[]
}
model SaleDiscount {
 id Int @id @default(autoincrement())
 saleId Int
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 itemId Int?
 item SaleItem? @relation(fields:[itemId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 kind String @db.VarChar(30)
 type String @db.VarChar(20)
 scope String @db.VarChar(20)
 value Decimal @db.Decimal(12,2)
 baseAmount Decimal @db.Decimal(12,2)
 amount Decimal @db.Decimal(12,2)
 reason String @db.VarChar(1000)
 actorId Int
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 createdAt DateTime @default(now())
}
model SessionEntitlement {
 id Int @id @default(autoincrement())
 saleId Int
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 saleItemId Int @unique
 saleItem SaleItem @relation(fields:[saleItemId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 variationId Int?
 variation ProcedureVariation? @relation(fields:[variationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 description String @db.VarChar(255)
 quantity Int
 expiresAt DateTime?
