}
model SessionRedemption {
 id Int @id @default(autoincrement())
 entitlementId Int
 entitlement SessionEntitlement @relation(fields:[entitlementId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 executionId Int? @unique
 execution ProcedureExecution? @relation("ExecutionRedemption",fields:[executionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 quantityDelta Int
 actorId Int
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 reason String? @db.VarChar(1000)
 requestKey String @unique @db.VarChar(100)
 reversesId Int? @unique
 reverses SessionRedemption? @relation("RedemptionReversal",fields:[reversesId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 reversal SessionRedemption? @relation("RedemptionReversal")
 createdAt DateTime @default(now())
 @@index([entitlementId,createdAt])
}
model ReceivableInstallment {
 id Int @id @default(autoincrement())
 saleId Int
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 number Int
 amount Decimal @db.Decimal(12,2)
 dueOn DateTime @db.Date
 allocations PaymentAllocation[]
 @@unique([saleId,number])
}
model PaymentAllocation {
 id Int @id @default(autoincrement())
 paymentId Int
 payment SalePayment @relation(fields:[paymentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 receivableId Int
 receivable ReceivableInstallment @relation(fields:[receivableId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 amount Decimal @db.Decimal(12,2)
 @@unique([paymentId,receivableId])
}
model PaymentReversal {
 id Int @id @default(autoincrement())
 paymentId Int @unique
 payment SalePayment @relation(fields:[paymentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 actorId Int
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 reason String @db.VarChar(1000)
 requestKey String @unique @db.VarChar(80)
 createdAt DateTime @default(now())
}
model CommercialEvent {
 id Int @id @default(autoincrement())
 saleId Int?
