generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  FUNCIONARIO
}
enum AcquisitionSource {
  INDICACAO
  INSTAGRAM
  WHATSAPP
  GOOGLE
  OUTRO
}
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
enum LeadStatus {
  NEW
  CONTACTED
}
enum PaymentMethod {
  PIX
  CASH
  CARD
}
enum ExpenseCategory {
  INSUMOS
  EQUIPAMENTOS_MANUTENCAO
  MARKETING
  ALUGUEL_ESTRUTURA
  SERVICOS
  PESSOAL
  OUTROS
}
enum ExpenseRecurrence {
  ONCE
  RECURRING
}
enum MovementType {
  IN
  ADJUSTMENT
  CONSUMPTION
}
enum DocumentType {
  ANAMNESIS
  CONTRACT
  OTHER
}
enum DocumentStatus {
  AWAITING_SIGNATURE
  SIGNED
}
enum PhotoLabel {
  BEFORE
  AFTER
  EVOLUTION
  OTHER
}
model User {
 offers CommercialOffer[]
 offerVersions CommercialOfferVersion[]
 commercialEvents CommercialEvent[]
 saleDiscounts SaleDiscount[]
 recordedSales Sale[] @relation("SaleRecorder")
 recordedPayments SalePayment[] @relation("PaymentRecorder")
 paymentReversals PaymentReversal[]
 sessionRedemptions SessionRedemption[]

 cancelledAttendances Attendance[] @relation("AttendanceCanceller")
 startedAttendances Attendance[] @relation("AttendanceStarter")
 completedAttendances Attendance[] @relation("AttendanceCompleter")
 shotEntries ShotLedgerEntry[]
 stockEntries StockMovement[]
 qualificationChanges QualificationChange[]
 id Int @id @default(autoincrement())
 name String @db.VarChar(120)
 email String @unique @db.VarChar(190)
 passwordHash String @db.VarChar(255)
 role Role @default(FUNCIONARIO)
 professionalId Int? @unique
 professional Professional? @relation(fields:[professionalId],references:[id],onDelete:SetNull)
 equipmentReviews Procedure[] @relation("EquipmentReviewer")
 equipmentEvents EquipmentEvent[]
 sessions Session[]
 blocks AgendaBlock[]
 createdAt DateTime @default(now())
}
model Session {
 id Int @id @default(autoincrement())
 tokenHash String @unique @db.VarChar(64)
 userId Int
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([userId,expiresAt])
}
model Professional {
 qualificationChanges QualificationChange[]
 id Int @id @default(autoincrement())
 name String @db.VarChar(120)
 phone String? @db.VarChar(30)
 email String? @db.VarChar(190)
 color String @default("#0d9488") @db.VarChar(16)
 active Boolean @default(true)
 user User?
 schedulingPriority Int?
 qualifications ProfessionalProcedureQualification[]
 workingPeriods ProfessionalWorkingPeriod[]
 attendances Attendance[]
 executions ProcedureExecution[]
 appointments Appointment[]
 blocks AgendaBlock[]
 sales Sale[]
}
model Customer {
 entitlements SessionEntitlement[]

 attendances Attendance[]
 id Int @id @default(autoincrement())
 name String @db.VarChar(120)
 phone String @db.VarChar(30)
 email String? @db.VarChar(190)
 birthDate DateTime? @db.Date
 acquisitionSource AcquisitionSource @default(OUTRO)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 appointments Appointment[]
 notes CustomerNote[]
 documents CustomerDocument[]
 photos CustomerPhoto[]
 sales Sale[]
 @@index([name])
 @@index([phone])
 @@map("customers")
}
model ProcedureCategory {
 id Int @id @default(autoincrement())
 name String @unique @db.VarChar(120)
 procedures Procedure[]
 leads Lead[]
}
enum ProcedureTechnology {
  GENERAL
  HIFU
  LASER_HAIR_REMOVAL
  TATTOO_REMOVAL
}
enum TreatmentOptionKind {
  AREA
  SIZE
  OTHER
}
model Procedure {
 offerItems CommercialOfferItem[]
 entitlements SessionEntitlement[]

 qualificationChanges QualificationChange[]
 qualifications ProfessionalProcedureQualification[]
 executions ProcedureExecution[]
  technology ProcedureTechnology @default(GENERAL)
  requiresEquipment Boolean @default(false)
  equipmentLinks ProcedureEquipment[]
  equipmentReviewedAt DateTime?
  equipmentReviewedById Int?
  equipmentReviewedBy User? @relation("EquipmentReviewer",fields:[equipmentReviewedById],references:[id],onDelete:Restrict)
  materialsReviewedAt DateTime?
  saleItems SaleItem[]
 id Int @id @default(autoincrement())
 categoryId Int
 category ProcedureCategory @relation(fields:[categoryId],references:[id])
 name String @db.VarChar(150)
 description String? @db.Text
 coverImageUrl String? @db.VarChar(300)
 detailImageUrl String? @db.VarChar(300)
 durationMinutes Int
 price Decimal @db.Decimal(12,2)
 active Boolean @default(true)
 variations ProcedureVariation[]
 appointments Appointment[]
 materials ProcedureMaterial[]
 @@index([categoryId])
}
model ProcedureVariation {
 offerItems CommercialOfferItem[]
 soldItems SaleItem[]
 entitlements SessionEntitlement[]

 executions ProcedureExecution[]
 kind TreatmentOptionKind @default(OTHER)
 id Int @id @default(autoincrement())
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Cascade)
 groupName String? @db.VarChar(80)
 name String @db.VarChar(140)
 reference String? @db.VarChar(140)
 price Decimal @db.Decimal(12,2)
 active Boolean @default(true)
 sortOrder Int @default(0)
}
model Appointment {
 sessionReservation SessionReservation?

 attendance Attendance?
 equipmentId Int?
 equipment Equipment? @relation(fields:[equipmentId],references:[id],onDelete:Restrict)
 origin String @default("INTERNAL") @db.VarChar(30)
 expiresAt DateTime?
 id Int @id @default(autoincrement())
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id])
 professionalId Int
 professional Professional @relation(fields:[professionalId],references:[id])
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id])
 startsAt DateTime
 endsAt DateTime
 status AppointmentStatus @default(SCHEDULED)
 documents CustomerDocument[]
 photos CustomerPhoto[]
 createdAt DateTime @default(now())
 @@index([professionalId, startsAt, endsAt])
 @@index([customerId,startsAt])
 @@index([equipmentId,startsAt,endsAt])
 @@index([status,expiresAt])
}
model AgendaBlock {
 id Int @id @default(autoincrement())
 professionalId Int
 professional Professional @relation(fields:[professionalId],references:[id])
 createdByUserId Int
 createdBy User @relation(fields:[createdByUserId],references:[id])
 startsAt DateTime
 endsAt DateTime
 reason String? @db.VarChar(250)
 @@index([professionalId, startsAt, endsAt])
}
model CustomerNote {
 id Int @id @default(autoincrement())
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 title String @db.VarChar(150)
 content String @db.Text
 author String @db.VarChar(120)
 createdAt DateTime @default(now())
}
model CustomerDocument {
 id Int @id @default(autoincrement())
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 appointmentId Int?
 appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull)
 procedureId Int?
 procedureName String? @db.VarChar(150)
 type DocumentType
 status DocumentStatus
 fileUrl String @db.VarChar(320)
 originalFilename String @db.VarChar(255)
 signedBy String? @db.VarChar(120)
 signedAt DateTime?
 note String? @db.Text
 createdAt DateTime @default(now())
}
model CustomerPhoto {
 id Int @id @default(autoincrement())
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 appointmentId Int?
 appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:SetNull)
 procedureId Int?
 procedureName String? @db.VarChar(150)
 label PhotoLabel?
 fileUrl String @db.VarChar(320)
 originalFilename String @db.VarChar(255)
 note String? @db.Text
 createdAt DateTime @default(now())
}
model Sale {
 commercialModel String @default("LEGACY") @db.VarChar(20)
 actorId Int?
 actor User? @relation("SaleRecorder",fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 requestKey String? @unique @db.VarChar(80)
 requestHash String? @db.VarChar(64)
 confirmedAt DateTime?
 allowUnpaidUse Boolean?
 offerPurchases SaleOfferPurchase[]
 discountRecords SaleDiscount[]
 receivables ReceivableInstallment[]
 entitlements SessionEntitlement[]
 events CommercialEvent[]

 id Int @id @default(autoincrement())
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id])
 professionalId Int?
 professional Professional? @relation(fields:[professionalId],references:[id])
 discount Decimal @db.Decimal(12,2) @default(0)
 commissionPercent Decimal? @db.Decimal(5,2)
 cancelled Boolean @default(false)
 createdAt DateTime @default(now())
 items SaleItem[]
 payments SalePayment[]
 @@index([createdAt])
}
model SaleItem {
 variationId Int?
 variation ProcedureVariation? @relation(fields:[variationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 variationName String? @db.VarChar(140)
 offerPurchaseId Int?
 offerPurchase SaleOfferPurchase? @relation(fields:[offerPurchaseId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 referenceAmount Decimal? @db.Decimal(12,2)
 promotionalDiscount Decimal? @db.Decimal(12,2)
 negotiatedDiscount Decimal? @db.Decimal(12,2)
 netAmount Decimal? @db.Decimal(12,2)
 entitlements SessionEntitlement[]
 discountRecords SaleDiscount[]

 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 id Int @id @default(autoincrement())
 saleId Int
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 description String @db.VarChar(255)
 sessions Int
 unitPrice Decimal @db.Decimal(12,2)
 finalPrice Decimal @db.Decimal(12,2)
}
model SalePayment {
 actorId Int?
 actor User? @relation("PaymentRecorder",fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 requestKey String? @unique @db.VarChar(80)
 reversal PaymentReversal?
 allocations PaymentAllocation[]

 id Int @id @default(autoincrement())
 saleId Int
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 paidAt DateTime @default(now())
 method PaymentMethod
 installments Int?
 amount Decimal @db.Decimal(12,2)
}
model Expense {
 id Int @id @default(autoincrement())
 description String @db.VarChar(255)
 category ExpenseCategory
 supplier String? @db.VarChar(190)
 amount Decimal @db.Decimal(12,2)
 dueDate DateTime @db.Date
 paid Boolean @default(false)
 paidAt DateTime?
 method PaymentMethod?
 recurrence ExpenseRecurrence
 cancelled Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([dueDate])
}
model Lead {
 id Int @id @default(autoincrement())
 name String @db.VarChar(120)
 phone String @db.VarChar(30)
 procedureCategoryId Int?
 procedureCategory ProcedureCategory? @relation(fields:[procedureCategoryId],references:[id])
 message String? @db.Text
 status LeadStatus @default(NEW)
 createdAt DateTime @default(now())
}
model StockItem {
 usages MaterialUsage[]
 id Int @id @default(autoincrement())
 name String @db.VarChar(150)
 unit String @db.VarChar(30)
 quantity Decimal @db.Decimal(12,3) @default(0)
 minQuantity Decimal @db.Decimal(12,3) @default(0)
 active Boolean @default(true)
 movements StockMovement[]
 materials ProcedureMaterial[]
}
model StockMovement {
 actor User? @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 actorId Int?
 requestKey String? @unique @db.VarChar(80)
 reversesId Int? @unique
 reverses StockMovement? @relation("StockReversal",fields:[reversesId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 reversal StockMovement? @relation("StockReversal")
 id Int @id @default(autoincrement())
 stockItemId Int
 stockItem StockItem @relation(fields:[stockItemId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 type MovementType
 quantityDelta Decimal @db.Decimal(12,3)
 note String? @db.VarChar(255)
 createdAt DateTime @default(now())
}
model ProcedureMaterial {
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Cascade)
 stockItemId Int
 stockItem StockItem @relation(fields:[stockItemId],references:[id])
 quantity Decimal @db.Decimal(12,3)
 @@id([procedureId,stockItemId])
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}
enum ShotTracking {
  NONE
  EQUIPMENT
  COMPONENT
}
model Equipment {
 appointments Appointment[]
 executions ProcedureExecution[]
 shotEntries ShotLedgerEntry[]
  id Int @id @default(autoincrement())
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)
  manufacturer String? @db.VarChar(120)
  model String? @db.VarChar(120)
  serialNumber String? @db.VarChar(120)
  status EquipmentStatus @default(ACTIVE)
  shotTracking ShotTracking @default(NONE)
  maintenanceIntervalMonths Int @default(12)
  lastMaintenanceDate DateTime? @db.Date
  nextMaintenanceDate DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  components EquipmentComponent[]
  procedures ProcedureEquipment[]
  events EquipmentEvent[]
  @@index([status,nextMaintenanceDate])
}
model EquipmentComponent {
 shotEntries ShotLedgerEntry[]
  id Int @id @default(autoincrement())
  equipmentId Int
  equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Restrict)
  code String @unique @db.VarChar(50)
  name String @db.VarChar(150)
  serialNumber String? @db.VarChar(120)
  specification String? @db.VarChar(500)
  nominalCapacity Int?
  status EquipmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events EquipmentEvent[]
  @@index([equipmentId,status])
}
model ProcedureEquipment {
  procedureId Int
  procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict)
  equipmentId Int
  equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Restrict)
  active Boolean @default(true)
  @@id([procedureId,equipmentId])
}
model EquipmentEvent {
  id Int @id @default(autoincrement())
  equipmentId Int
  equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Restrict)
  componentId Int?
  component EquipmentComponent? @relation(fields:[componentId],references:[id],onDelete:Restrict)
  actorId Int
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  type String @db.VarChar(50)
  reason String? @db.VarChar(1000)
  details Json
  occurredOn DateTime? @db.Date
  createdAt DateTime @default(now())
  @@index([equipmentId,createdAt])
}

model ProfessionalProcedureQualification {
 professionalId Int
 professional Professional @relation(fields:[professionalId],references:[id],onDelete:Restrict)
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict)
 active Boolean @default(true)
 updatedAt DateTime @updatedAt
 @@id([professionalId,procedureId])
 @@index([procedureId,active])
}
model QualificationChange {
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 professional Professional @relation(fields:[professionalId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 id Int @id @default(autoincrement())
 professionalId Int
 procedureId Int
 active Boolean
 actorId Int
 createdAt DateTime @default(now())
 @@index([professionalId,createdAt])
}
model ProfessionalWorkingPeriod {
 id Int @id @default(autoincrement())
 professionalId Int
 professional Professional @relation(fields:[professionalId],references:[id],onDelete:Restrict)
 weekday Int
 startMinute Int
 endMinute Int
 @@index([professionalId,weekday])
}
model SchedulingSettings {
 id Int @id
 assignmentPolicy String @default("PRIORITY") @db.VarChar(30)
 confirmationMode String @default("MANUAL") @db.VarChar(30)
 holdMinutes Int @default(1440)
}
model Attendance {
 cancelledAt DateTime?
 cancellationReason String? @db.VarChar(1000)
 cancelledById Int?
 cancelledBy User? @relation("AttendanceCanceller",fields:[cancelledById],references:[id],onDelete:Restrict)
 startedById Int
 startedBy User @relation("AttendanceStarter",fields:[startedById],references:[id],onDelete:Restrict)
 completedById Int?
 completedBy User? @relation("AttendanceCompleter",fields:[completedById],references:[id],onDelete:Restrict)
 id Int @id @default(autoincrement())
 appointmentId Int? @unique
 appointment Appointment? @relation(fields:[appointmentId],references:[id],onDelete:Restrict)
 customerId Int
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
 professionalId Int
 professional Professional @relation(fields:[professionalId],references:[id],onDelete:Restrict)
 status String @default("IN_PROGRESS") @db.VarChar(30)
 startedAt DateTime @default(now())
 completedAt DateTime?
 completionKey String? @unique @db.VarChar(80)
 completionHash String? @db.VarChar(64)
 executions ProcedureExecution[]
 @@index([customerId,startedAt])
}
model ProcedureExecution {
 redemption SessionRedemption? @relation("ExecutionRedemption")

 id Int @id @default(autoincrement())
 attendanceId Int
 attendance Attendance @relation(fields:[attendanceId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 procedureId Int
 procedure Procedure @relation(fields:[procedureId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 variationId Int?
 variation ProcedureVariation? @relation(fields:[variationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 professionalId Int
 professional Professional @relation(fields:[professionalId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 equipmentId Int?
 equipment Equipment? @relation(fields:[equipmentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 procedureName String @db.VarChar(150)
 variationName String? @db.VarChar(140)
 technology ProcedureTechnology
 materials MaterialUsage[]
 shots ShotLedgerEntry[]
 @@index([procedureId,attendanceId])
}
model MaterialUsage {
 usage String @db.VarChar(20)
 id Int @id @default(autoincrement())
 executionId Int
 execution ProcedureExecution @relation(fields:[executionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 stockItemId Int
 stockItem StockItem @relation(fields:[stockItemId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 materialName String @db.VarChar(150)
 @@unique([executionId,stockItemId])
}
model ShotLedgerEntry {
 replacesId Int? @unique
 replaces ShotLedgerEntry? @relation("ShotReplacement",fields:[replacesId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 replacement ShotLedgerEntry? @relation("ShotReplacement")
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 id Int @id @default(autoincrement())
 equipmentId Int
 equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 componentId Int?
 component EquipmentComponent? @relation(fields:[componentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 executionId Int?
 execution ProcedureExecution? @relation(fields:[executionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 type String @db.VarChar(30)
 quantityDelta Int
 actorId Int
 reason String? @db.VarChar(1000)
 requestKey String @unique @db.VarChar(100)
 reversesId Int? @unique
 reverses ShotLedgerEntry? @relation("ShotReversal",fields:[reversesId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 reversal ShotLedgerEntry? @relation("ShotReversal")
 createdAt DateTime @default(now())
 @@index([equipmentId,componentId,createdAt])
}

model CommercialOffer {
 id Int @id @default(autoincrement())
 name String @db.VarChar(150)
 active Boolean @default(true)
 actorId Int
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 createdAt DateTime @default(now())
 versions CommercialOfferVersion[]
 events CommercialEvent[]
}
model CommercialOfferVersion {
 id Int @id @default(autoincrement())
 offerId Int
 offer CommercialOffer @relation(fields:[offerId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 version Int
 name String @db.VarChar(150)
 startsOn DateTime @db.Date
 endsOn DateTime? @db.Date
 sessionValidityDays Int?
 price Decimal @db.Decimal(12,2)
 referenceAmount Decimal @db.Decimal(12,2)
 terms String? @db.VarChar(2000)
 actorId Int
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 createdAt DateTime @default(now())
 items CommercialOfferItem[]
 purchases SaleOfferPurchase[]
