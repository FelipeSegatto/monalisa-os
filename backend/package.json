{
  "name": "agenda-clinica-api-nestjs",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "start": "node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed-bootstrap.ts",
    "test": "tsx --test test/*.test.ts test/equipments/*.test.ts test/contracts/*.test.ts test/auth/*.test.ts test/customers/*.test.ts test/professionals/*.test.ts test/procedures/*.test.ts test/clinical/*.test.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "db:seed:equipment": "tsx prisma/seed-equipment.ts",
    "predev": "node ../scripts/check-node.mjs",
    "prebuild": "node ../scripts/check-node.mjs",
    "prestart": "node ../scripts/check-node.mjs",
    "pretest": "node ../scripts/check-node.mjs",
    "preinstall": "node ../scripts/check-node.mjs",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed:demo": "tsx prisma/seed.ts",
    "test:contracts:compiled": "npm run build && node scripts/run-contracts.mjs compiled",
    "test:mysql:clinical": "node scripts/test-clinical-mysql.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "6.19.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0"
}
